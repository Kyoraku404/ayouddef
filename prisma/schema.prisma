generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================== ENUMS ===================

enum ReservationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum WhatsAppLeadStatus {
  CLICKED
  INITIATED
  CHATTING
  QUOTE_SENT
  CONVERTED
  ABANDONED
}

enum AnalyticsEventType {
  PAGE_VIEW
  VISITOR
  CLICK
  WHATSAPP_CLICK
  PHONE_CLICK
  INSTAGRAM_CLICK
  RESERVATION_START
  RESERVATION_SUBMITTED
}

// =================== CORE OCN MODELS ===================

model AdminUser {
  id                 String    @id @default(cuid())
  username           String    @unique
  email              String?   @unique
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Client {
  id                    String                 @id @default(cuid())
  legalName             String
  displayName           String
  contactEmail          String?
  contactPhone          String?
  ownershipClient       Decimal                @default(70.00) @db.Decimal(5, 2)
  ownershipOcn          Decimal                @default(30.00) @db.Decimal(5, 2)
  revenueShareOcn       Decimal                @default(10.00) @db.Decimal(5, 2)
  maintenanceStatus     String                 @default("ACTIVE")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  websites              Website[]
  commercialAgreements  CommercialAgreement[]
  reservations          Reservation[]
  revenues              Revenue[]
  settlements           Settlement[]
  analyticsEvents       AnalyticsEvent[]
  auditLogs             AuditLog[]
}

model Website {
  id              String           @id @default(cuid())
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  domain          String           @unique
  name            String
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  analyticsEvents AnalyticsEvent[]
  reservations    Reservation[]
  revenues        Revenue[]

  @@index([clientId])
}

model CommercialAgreement {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  version            String    @default("v1.2 - 2026")
  title              String
  effectiveDate      DateTime  @default(now())
  ownershipClient    Decimal   @default(70.00) @db.Decimal(5, 2)
  ownershipOcn       Decimal   @default(30.00) @db.Decimal(5, 2)
  revenueShareOcn    Decimal   @default(10.00) @db.Decimal(5, 2)
  status             String    @default("ACTIVE")
  clauses            Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([clientId])
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  clientId  String
  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  websiteId String
  website   Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  eventType AnalyticsEventType
  page      String
  referrer  String?
  userAgent String?
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([clientId, eventType, createdAt])
  @@index([websiteId, createdAt])
}

model Reservation {
  id                 String                    @id @default(cuid())
  clientId           String
  client             Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  websiteId          String
  website            Website                   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  customerName       String
  customerEmail      String
  customerPhone      String
  serviceTitle       String
  bookingDate        DateTime
  partySize          Int                       @default(2)
  status             ReservationStatus         @default(PENDING)
  whatsappLeadStatus WhatsAppLeadStatus        @default(CLICKED)
  revenueAmount      Decimal?                  @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  statusHistory      ReservationStatusHistory[]
  revenue            Revenue?

  @@index([clientId, status])
  @@index([websiteId, createdAt])
}

model ReservationStatusHistory {
  id            String             @id @default(cuid())
  reservationId String
  reservation   Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  changedBy     String
  notes         String?
  createdAt     DateTime           @default(now())

  @@index([reservationId, createdAt])
}

model RevenuePeriod {
  id          String       @id // e.g. "2026-H1", "2026-H2"
  periodName  String
  startDate   DateTime
  endDate     DateTime
  dueDate     DateTime
  status      String       @default("OPEN") // OPEN, CLOSED, RECONCILED
  createdAt   DateTime     @default(now())

  revenues    Revenue[]
  settlements Settlement[]
}

model Revenue {
  id                    String           @id @default(cuid())
  reservationId         String?          @unique
  reservation           Reservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  clientId              String
  client                Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  websiteId             String
  website               Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  periodId              String
  period                RevenuePeriod    @relation(fields: [periodId], references: [id])
  serviceTitle          String
  grossAmount           Decimal          @db.Decimal(10, 2)
  refundAmount          Decimal          @default(0.00) @db.Decimal(10, 2)
  processingFees        Decimal          @default(0.00) @db.Decimal(10, 2)
  definedRevenue        Decimal          @db.Decimal(10, 2)
  isVerified            Boolean          @default(true)
  verifiedAt            DateTime?
  verifiedBy            String?
  isCorrection          Boolean          @default(false)
  originalRevenueId     String?
  correctionReason      String?
  settlementStatus      String           @default("UNPAID") // UNPAID, PARTIAL, PAID
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  revenueShare          OcnRevenueShare?

  @@index([clientId, periodId])
  @@index([isVerified, settlementStatus])
}

model OcnRevenueShare {
  id               String   @id @default(cuid())
  revenueId        String   @unique
  revenue          Revenue  @relation(fields: [revenueId], references: [id], onDelete: Cascade)
  ocnPercentage    Decimal  @default(10.00) @db.Decimal(5, 2)
  clientPercentage Decimal  @default(90.00) @db.Decimal(5, 2)
  ocnAmount        Decimal  @db.Decimal(10, 2)
  clientAmount     Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Settlement {
  id               String        @id @default(cuid())
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodId         String
  period           RevenuePeriod @relation(fields: [periodId], references: [id])
  grossRevenue     Decimal       @db.Decimal(10, 2)
  definedRevenue   Decimal       @db.Decimal(10, 2)
  ocnShare         Decimal       @db.Decimal(10, 2)
  amountPaid       Decimal       @default(0.00) @db.Decimal(10, 2)
  balanceDue       Decimal       @db.Decimal(10, 2)
  status           String        @default("UNPAID") // UNPAID, PARTIAL, PAID
  paymentReference String?
  settledAt        DateTime?
  dueDate          DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([clientId, periodId])
}

model AuditLog {
  id          String   @id @default(cuid())
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  performedBy String
  details     Json
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([clientId, createdAt])
}

// =================== PUBLIC CLIENT SYSTEM COMPATIBILITY ===================

model Tour {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  icon            String
  getYourGuideUrl String?
  duration        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ZakyUser {
  id        String   @id @default(cuid())
  username  String   @unique @default("zaky")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteImage {
  id        String   @id @default(cuid())
  slotKey   String   @unique
  label     String
  url       String
  alt       String?
  caption   String?
  section   String   // "Hero", "About", "Brand & Identity", "Tour: Medina", etc.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
}

model TourPackage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  price       String   // e.g. "700 MAD"
  priceNote   String?  // e.g. "700 MAD per private group, up to 10 guests"
  duration    String?  // e.g. "3–4 hours"
  groupType   String?  // e.g. "1–10 guests | Private Tour"
  languages   String?  // e.g. "English, French, Arabic"
  badge       String?  // e.g. "Most Popular"
  description String?  @db.Text // LEGACY: kept as fallback only. Do not write new content here.
  // Card Description: short text shown ONLY on the main Tours page card.
  // Fully independent from fullDescription — editing one never touches the other.
  cardDescription String? @db.Text
  // Full Tour Description: detailed paragraphs shown ONLY on the individual
  // tour detail page (after "Discover More"). Paragraphs separated by blank lines.
  fullDescription String? @db.Text
  // Card visual: icon name (gate|basket|palace|tea|monument|compass|road)
  // and gradient theme class (t1..t7). Editable per tour from admin.
  icon        String?
  cls         String?
  // Card cover photo shown on the main Tours page card. When set, it replaces
  // the icon/gradient visual. Managed per tour from the admin panel.
  cardImage   String?
  highlights  String?  @db.Text
  included    String?  @db.Text
  notIncluded String?  @db.Text
  itinerary   String?  // JSON string of itinerary stops [{ stopNumber, name, duration, description, lat, lng }]
  mapCenter   String?  // JSON string of { lat, lng, zoom }
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GuideBio {
  id              String   @id @default("guide_zaky")
  name            String   @default("Zaky")
  fullName        String   @default("Mohamed Zaky Bentabaa")
  eyebrow         String   @default("Meet your guide")
  title           String   @default("About Me")
  bioP1           String   @db.Text
  bioP2           String   @db.Text
  bioP3           String   @db.Text
  bioP4           String   @db.Text
  signoff         String   @default("Marrakech, curated by Zaky")
  rating          String   @default("5.0★")
  reviewsCount    String   @default("41")
  experienceYears String   @default("19")
  signatureTours  String   @default("7")
  languages       String   @default("Arabic, French, English")
  badgeText       String   @default("41 verified Google reviews")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
